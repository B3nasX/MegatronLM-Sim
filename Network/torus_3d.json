    "nodes_per_rack": 4,
    "oversubscription_ratio": 4.0,
    "latency_cross_rack_us": 10.0,
    "nic_bw_gbps": 30.0,
    "num_nics_per_gpu": 1,
    "pcie_bw_gbps": 64.0,
    "header_bytes": 128,
    "chunk_size_bytes": 4194304,
    "bidirectional": true,
    "switch_latency_us": 0.5,
    "num_hops_intra_rack": 2,
    "num_hops_cross_rack": 6,
    "ring_tree_threshold_bytes": 1048576,
    "latency_jitter_us": 1.5,
